# Copy to scripts/stg-uat-old-db-handoff.local.env (gitignored) and chmod 600.
# Fill PlanetScale ephemeral role values. Do not commit. Do not use pscale connect.

export DB_HOST='<planetscale-host>'
export DB_PORT=5432
export DB_USER='<planetscale-user>'
export DB_PASSWORD='<planetscale-password>'
export DB_NAME=postgres
export DB_SSL_MODE=verify-full
export DB_SSL_ROOT_CERT=system
