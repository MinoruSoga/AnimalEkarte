# =============================================================
# Environment Variables Template
# Usage: cp .env.example .env  →  docker compose up
# =============================================================

# Database (local Docker)
DB_HOST=db
DB_PORT=5432
DB_USER=ekarte_user
DB_PASSWORD=ekarte_password
DB_NAME=ekarte_db
DB_SSL_MODE=disable

# Application
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug

# Auth
JWT_SECRET=284d5866ede083206f50a21d945cd7520348d0d3109371b9de182254eb92fb5f

# CORS (local)
CORS_ALLOWED_ORIGIN=http://localhost:3003
COOKIE_DOMAIN=localhost
COOKIE_CROSS_DOMAIN=false

# Migration
DB_RESET=false

# Dev Admin Bypass (ローカル開発専用: 空のままにすると無効)
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
