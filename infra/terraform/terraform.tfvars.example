# Example terraform.tfvars
# Copy this file to terraform.tfvars and set your values

name_prefix  = "animalekarte-test"
project_name = "animalekarte"
environment  = "test"

# Database Configuration
db_name     = "ekarte_db"
db_username = "ekarte_admin"
db_password = "CHANGE_ME_STRONG_PASSWORD" # Must be at least 8 characters

# RDS Configuration
rds_instance_class          = "db.t4g.micro" # or db.t3.micro if t4g is unavailable
rds_allocated_storage       = 20
rds_backup_retention_period = 1

# Application Configuration
cors_allowed_origin  = "https://your-frontend.vercel.app,https://your-cloudfront-id.cloudfront.net"
cookie_cross_domain  = true  # Required for cross-domain cookie (Vercel + CloudFront)

# GitHub Configuration
github_repo = "YourOrg/YourRepo"
