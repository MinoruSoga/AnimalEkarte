# 値はすべて環境変数(TF_VAR_*)で供給すること。このファイルに実値を書かない。
# terraform.tfvars(実ファイル)は .gitignore 対象。コミットするのはこの .example のみ。
#
# account_id             = "CLOUDFLARE_ACCOUNT_ID と同値。TF_VAR_account_id で供給推奨"
# pscale_stg_db_host     = "pscale role reset-default animalekarte-stg main --org noah-animalekarte --force で取得"
# pscale_stg_db_user     = "同上"
# pscale_stg_db_password = "同上(都度発行の短命クレデンシャルを推奨。使い終わったら再度 reset-default で失効させる)"
