FROM golang:1.25-alpine

WORKDIR /app

# CGo（-race フラグ対応）。リモート installer 取得用の curl は入れない
RUN apk add --no-cache gcc musl-dev tzdata

ENV TZ=Asia/Tokyo

# 開発ツール
# 再現性のため pin（FE6-1 の tygo pin と同方針）。更新は明示的な bump コミットで行う
RUN go install github.com/air-verse/air@v1.65.3

# golangci-lint は in-image に入れない。
# make lint / make ci が公式 pin イメージ golangci/golangci-lint:v2.11.4 を使う
# （docs/ops/ci-policy.md: リモート pipe-to-shell installer 禁止）

COPY go.mod go.sum ./
COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

EXPOSE 8080

ENTRYPOINT ["./entrypoint.sh"]
