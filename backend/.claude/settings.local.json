{
  "disabledMcpjsonServers": [
    "github",
    "chrome-devtools",
    "context7-mcp",
    "postgresql",
    "figma",
    "notion"
  ],
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(go:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(*|bash*)",
      "Bash(* | bash*)",
      "Bash(*|sh*)",
      "Bash(* | sh*)",
      "Bash(*> /dev/disk*)",
      "Bash(*>/dev/disk*)",
      "Bash(*> /dev/rdisk*)",
      "Bash(*>/dev/rdisk*)",
      "Bash(*> /dev/sd*)",
      "Bash(*>/dev/sd*)",
      "Bash(*> /dev/hd*)",
      "Bash(*>/dev/hd*)",
      "Bash(*> /dev/vd*)",
      "Bash(*>/dev/vd*)",
      "Bash(*> /dev/xvd*)",
      "Bash(*>/dev/xvd*)",
      "Bash(*> /dev/nvme*)",
      "Bash(*>/dev/nvme*)",
      "Bash(*> /dev/mmcblk*)",
      "Bash(*>/dev/mmcblk*)",
      "Bash(*> /dev/loop*)",
      "Bash(*>/dev/loop*)",
      "Bash(*> /dev/dm-*)",
      "Bash(*>/dev/dm-*)",
      "Bash(*> /dev/md*)",
      "Bash(*>/dev/md*)",
      "Bash(*> /dev/ada*)",
      "Bash(*>/dev/ada*)",
      "Bash(*> /dev/da*)",
      "Bash(*>/dev/da*)",
      "Bash(*> /dev/nvd*)",
      "Bash(*>/dev/nvd*)",
      "Bash(*> /dev/mapper/*)",
      "Bash(*>/dev/mapper/*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./api-keys.json)",
      "Read(./secrets.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.crt)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.cache/**)",
      "Read(./**/*.db)",
      "Read(./**/*.log)",
      "Read(./logs/**)",
      "Read(./.git/**)",
      "Read(./temp/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./.git/**)",
      "Edit(./node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ROOT=\"$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel)\" || exit 2; NODE=\"$(command -v node)\" || exit 2; test -f \"$ROOT/.claude/hooks/pre-bash-block-dangerous.js\" || exit 2; CLAUDE_PROJECT_DIR=\"$ROOT\" \"$NODE\" \"$ROOT/.claude/hooks/pre-bash-block-dangerous.js\"; STATUS=$?; test \"$STATUS\" -eq 0 || exit 2"
          }
        ]
      }
    ]
  }
}
