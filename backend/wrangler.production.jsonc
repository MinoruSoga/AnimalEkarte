// Cloudflare Workers + Containers 設定 — Production。
// 正本は backend/wrangler.jsonc（STG）。本ファイルはその production 版ドラフトであり、
// PO 決定（2026-07-15）「納品はCloudflare経路。本番もCF構成で新設」/ 追跡Issue #253 に基づく。
// 現行構成: docs/ops/infra/architecture.md。本番手順: docs/ops/infra/production/setup.md。
//
// 【重要】本ファイルは新規ドラフトであり、STG のように実測・apply 済みの値は含まない。
// 適用前に必ず以下の PLACEHOLDER をすべて実値へ置換すること（詳細手順は
// docs/ops/infra/production/setup.md 参照）。
//
//   1. vars.TRUSTED_PROXY_CIDR
//      → STG は試行9で /health に一時追加した診断フィールドで Worker→Container 内部
//        プロキシの実ソースIPを実測して確定した値（10.1.0.0/32）。production の値は
//        「同一 Cloudflare アカウント・同一 Containers 構成だから恐らく同じ」という推測に
//        すぎず未検証のため、STG値をそのまま複製しない。初回デプロイ後に同じ手法
//        （/health への一時診断フィールド追加 → 複数リクエストでの安定確認）で実測し、
//        確定するまでは値を空にせず STG 値を「検証対象の候補」としてコメントで残す。
//        誤りの効果は非対称: 広すぎる値は X-Forwarded-For 偽装によるレート制限バイパス
//        （H2 相当の実害）、狭すぎる値は可用性の問題（正当なリクエストが単一バケット扱いに
//        なるだけ）に留まる。実測前に安易に広げないこと。
//   2. vars.S3_PUBLIC_BASE_URL
//      → R2 の公開ドメインを production 用に作成後、運用担当者が投入する
//        （STG と同じ運用。空文字のままだと医療画像の公開 URLは API ホストへ暫定
//        フォールバックし、起動時に警告ログが出る）。
//   3. secrets.required に列挙された各シークレット
//      → 値は本ファイルに書かない。`wrangler secret put <NAME> -c wrangler.production.jsonc`
//        で個別投入する。JWT_SECRET / INTEGRATION_ENCRYPTION_KEY / MIGRATE_RUN_SECRET は
//        STG の値を絶対に使い回さないこと（STG 側の漏洩が production を即座に侵害する
//        経路になるため、新規に生成する）。
//
// 未使用の Workers DB プール binding は SEC-CS2-F03 で削除。Container は PlanetScale へ
// DB_* 直結 (https://github.com/cloudflare/containers/issues/97)。対応 Terraform resource
// も除去済み。
//
// S3_ENDPOINT のアカウントID（776ddc3e975e8fe5773d5300522e2404）は STG と同一 Cloudflare
// アカウントを production でも使う前提（課金・管理の一元化）で、backend/wrangler.jsonc
// に既に公開値として存在するものを再利用
// している。新しい ID を書き起こしたものではない。もし production を別アカウントに分離する
// 判断がなされた場合はここを差し替えること。
//
// デプロイは `wrangler deploy -c wrangler.production.jsonc`（-c で本ファイルを明示指定。
// 未指定時は wrangler.jsonc = STG が使われるため必ず -c を付けること）。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "animalekarte-prod-api",
  "main": "./worker/index.ts",
  // STG(wrangler.jsonc)と同一日付で開始する。以後 STG 側を更新した際は本ファイルも
  // 追随させること(2ファイルに分割されている構造上、自動同期はできない)。
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat_v2"],

  // production は最初から独自ドメイン route を使う(STGのような「NS切替待ちのため
  // 一時的にworkers_dev=trueで検証」というフェーズを踏まない)。critical path 上、
  // production 整備(#253)は STG Phase 7 (NS切替)完了後に着手する前提のため、
  // noah-karte.com ゾーンは着手時点で既に Cloudflare 上でactiveであり、
  // api.noah-karte.com の DNS レコード(proxied=true)を production/zone.tf で
  // 作成すればルートは初回applyから機能する。*.workers.dev 経由の公開は不要かつ
  // production を不必要に露出させない方針(STG運用原則を踏襲)。
  "workers_dev": false,

  "routes": [
    {
      "pattern": "api.noah-karte.com/*",
      "zone_name": "noah-karte.com",
    },
  ],

  // 非シークレットの設定値。Container の envVars へ backend/worker/index.ts 経由で渡す。
  "vars": {
    "GIN_MODE": "release",
    "LOG_LEVEL": "info",
    "SCHEDULER_ENVIRONMENT": "production",
    "DB_PORT": "5432",
    "DB_NAME": "postgres",
    "DB_SSL_MODE": "verify-full",
    "DB_SSL_ROOT_CERT": "system",
    // Cloudflare Containers はPlanetScaleへ直結するため、インスタンスごとの上限を
    // stagingと同じ安全値へ固定してconnection slot枯渇を防ぐ。
    "DB_MAX_OPEN_CONNS": "10",
    "DB_MAX_IDLE_CONNS": "5",

    // <PLACEHOLDER-TRUSTED_PROXY_CIDR-VERIFY-POST-DEPLOY>
    // 上記ファイル冒頭コメント #2 参照。STG実測値(10.1.0.0/32)を「検証対象の候補」として
    // 残すが、production 環境で同一であることは未確認。初回デプロイ後に実測して確定すること。
    "TRUSTED_PROXY_CIDR": "10.1.0.0/32",

    "CORS_ALLOWED_ORIGIN": "https://noah-karte.com,https://api.noah-karte.com",
    "FRONTEND_URL": "https://noah-karte.com",
    "SMTP_PORT": "587",
    "SMTP_FROM": "noreply@noah-karte.com",

    // R2(S3互換)ファイルストレージ。production 専用バケット(STGと共有しない)。
    "STORAGE_TYPE": "s3",
    "S3_BUCKET": "animalekarte-prod-images",
    "S3_REGION": "auto",
    "S3_SHARED_BUCKET": "animalekarte-prod-images",
    "S3_SHARED_REGION": "auto",
    // アカウントIDはSTGと同一(ファイル冒頭コメント参照。新規IDではない)。
    "S3_ENDPOINT": "https://776ddc3e975e8fe5773d5300522e2404.r2.cloudflarestorage.com",

    // <PLACEHOLDER-S3_PUBLIC_BASE_URL>
    // production 用 R2 公開ドメイン作成後に運用担当者が投入する(ファイル冒頭コメント #3 参照)。
    "S3_PUBLIC_BASE_URL": "",
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // STG と同じ UTC Cron 契約。production placeholder / secret 値には触れず、
  // 実デプロイは冒頭の全 placeholder 解消と承認後にのみ行う。
  "triggers": {
    "crons": ["0 1 * * *", "0 6,11 * * *", "0 17 * * *"],
  },

  "containers": [
    {
      "class_name": "AnimalEkarteApiContainer",
      // STG と同じ Dockerfile を使う(Go バイナリ自体は環境非依存。envVars のみで差分吸収)。
      "image": "./Dockerfile.production",
      // STG と同じ初期値(basic / 1vCPU4分の1・1GiB, max 3)。production の実トラフィックが
      // 出た後にキャパシティレビューを行うこと(未計測のため暫定値。placeholder ではなく
      // 「変更前提の初期値」として明記)。
      "instance_type": "basic",
      "max_instances": 3,
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "AnimalEkarteApiContainer",
      },
    ],
  },

  // production は STG とは別 Worker script(name が異なる)のため、DO migration 履歴も
  // 独立して v1 から始まる(STG の履歴を引き継がない・引き継げない)。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AnimalEkarteApiContainer"],
    },
  ],

  "r2_buckets": [
    {
      "binding": "MEDICAL_IMAGES",
      // infra/cloudflare/production/variables.tf の r2_bucket_name デフォルト値と一致させる。
      "bucket_name": "animalekarte-prod-images",
    },
  ],

  "secrets": {
    "required": [
      "DB_HOST",
      "DB_USER",
      "DB_PASSWORD",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      // STG と同一名だが値は別物。STG の値を使い回さないこと(ファイル冒頭コメント #4 参照)。
      "MIGRATE_RUN_SECRET",
      "SCHEDULER_OPS_SECRET",
      // DEC-36 / CMD-02: Worker→Container X-Scheduler-Token 共有秘密（値は secret put のみ）。
      // Cutover: secret put を先 → デプロイを最後。Go は expected 空で全リクエスト 401
      // (fail-closed on missing config) のため、secret 不在のデプロイは全院バッチ停止。
      "SCHEDULER_INTERNAL_TOKEN",
      "SCHEDULER_ACCESS_TEAM_DOMAIN",
      "SCHEDULER_ACCESS_AUDIENCE",
      "SCHEDULER_ALERT_ALLOWED_HOST",
      "SCHEDULER_ALERT_WEBHOOK_URL",
      "SCHEDULER_ALERT_WEBHOOK_SECRET",
      "JWT_SECRET",
      "INTEGRATION_ENCRYPTION_KEY",
      "SMTP_HOST",
      "SMTP_USER",
      "SMTP_PASS",
      // STGと差分なし(2026-07-16時点)。LINE_CHANNEL_ACCESS_TOKEN等の将来グローバルfallbackも
      // STGと同じ理由でrequired外(wrangler.jsonc本文コメント参照)。
    ],
  },
}
