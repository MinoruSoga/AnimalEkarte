{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": false,
  "attribution": {
    "enabled": true,
    "format": "Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>"
  },
  "outputStyle": "senior-engineer",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "teammateMode": "in-process",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "deny": [
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(go:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(*|bash:*)",
      "Bash(*|sh:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.gnupg/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./api-keys.json)",
      "Read(./secrets.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.crt)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./out/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.cache/**)",
      "Read(./**/*.db)",
      "Read(./**/*.log)",
      "Read(./logs/**)",
      "Read(./.git/**)",
      "Read(./temp/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Write(./.git/**)",
      "Write(./node_modules/**)"
    ],
    "allow": [
      "Bash(make:*)",
      "Bash(make up:*)",
      "Bash(make down:*)",
      "Bash(make logs:*)",
      "Bash(make db:*)",
      "Bash(make codegen:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose logs:*)",
      "Bash(gh:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git remote:*)",
      "Bash(docker compose up:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(chmod:*)",
      "Read(.claude/rules/**)",
      "Read(.claude/hooks/**)",
      "Read(frontend/src/**)",
      "Read(backend/**)",
      "Read(public/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Read(tmp/**)",
      "Write(.claude/rules/**)",
      "Write(.claude/hooks/**)",
      "Write(frontend/src/**)",
      "Write(backend/**)",
      "Write(tests/**)",
      "Write(docs/**)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(make clean:*)",
      "Bash(docker compose down:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",
      "Bash(docker restart:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git push origin --delete:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-block-dangerous.js"
          }
        ],
        "description": "Block destructive shell commands (rm -rf /, dd, mkfs)"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-block-no-verify.js"
          }
        ],
        "description": "Block --no-verify and --no-gpg-sign flags to protect git hooks"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-commit-quality.js"
          }
        ],
        "description": "Commit quality gate: block secrets, warn on console.log/debugger, validate commit message format"
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-write-large-file-block.js"
          }
        ],
        "description": "Block creation of files larger than 800 lines"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit-config-protection.js"
          }
        ],
        "description": "Warn when editing linter/formatter config files"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-console-warn.js"
          }
        ],
        "description": "Warn about console.log statements after edits or new file creation"
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-file-size-warn.js"
          }
        ],
        "description": "Warn when file exceeds 500/800 lines after edit (catches gradual growth)"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-compact-save-state.js"
          }
        ],
        "description": "Save git state and progress before context compaction"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-save-progress.js",
            "timeout": 10000
          }
        ],
        "description": "Save session progress snapshot for cross-session context persistence"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-desktop-notify.js",
            "timeout": 10000
          }
        ],
        "description": "Send macOS desktop notification when Claude finishes"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-init.sh"
          }
        ],
        "description": "Log session start and detect project type"
      }
    ]
  }
}
