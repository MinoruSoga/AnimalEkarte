#!/bin/sh
# Pre-commit hook: フロントエンドの lint + 型チェックを実行
# make setup-hooks でインストール

set -e

echo "Pre-commit: フロントエンドチェック開始..."

# コンテナが起動していない場合はスキップ（CI で実行される）
if ! docker compose exec -T frontend true 2>/dev/null; then
  echo "Pre-commit: frontendコンテナが未起動のためスキップします（make up で起動してください）"
  exit 0
fi

echo "  [1/2] lint..."
docker compose exec -T frontend npm run lint

echo "  [2/2] 型チェック (tsc --noEmit)..."
docker compose exec -T frontend npx tsc --noEmit

echo "Pre-commit: すべて通過。commit を続行します。"
