#!/bin/sh
# Lightweight commit gate: secrets + hard size limit only.
# Scoped lint/test lives on pre-push (outgoing HEAD vs remote base).
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
printf '%s\n' 'Pre-commit: secrets + file-size checks starting'
sh "$ROOT/.githooks/lib/check-secrets.sh"
sh "$ROOT/.githooks/lib/check-file-sizes.sh"
printf '%s\n' 'Pre-commit: secrets + file-size checks finished (scoped verify runs on pre-push).'
