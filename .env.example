# =============================================================
# Environment Variables Template
# Usage: cp .env.example .env  →  docker compose up
# =============================================================

# Database (local Docker)
DB_HOST=db
DB_PORT=5432
DB_USER=ekarte_user
DB_PASSWORD=ekarte_password
DB_NAME=ekarte_db
DB_SSL_MODE=disable

# Application
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug

# Auth
JWT_SECRET=dev-secret-change-me

# CORS (local)
CORS_ALLOWED_ORIGIN=http://localhost:3003
COOKIE_DOMAIN=localhost
COOKIE_CROSS_DOMAIN=false

# Migration
DB_RESET=false
