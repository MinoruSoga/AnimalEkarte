# AnimalEkarte — 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、実際の値を設定してください
# 注意: 実際の認証情報をこのファイルに記入しないでください

# =============================================================================
# バックエンド (Go / Gin)
# =============================================================================

# データベース接続
DB_HOST=localhost
DB_PORT=5432
DB_NAME=animalekarte
DB_USER=postgres
DB_PASSWORD=your-db-password

# JWT 認証
JWT_SECRET=your-jwt-secret-min-32-chars

# アプリケーション設定
APP_ENV=development
APP_PORT=8080
TRUSTED_PROXY_CIDR=127.0.0.1/32

# =============================================================================
# フロントエンド (React / Vite)
# =============================================================================

# バックエンド API エンドポイント
VITE_API_BASE_URL=http://localhost:8080

# LINE 連携
VITE_LIFF_ID=your-liff-id

# =============================================================================
# Vercel デプロイ (フロントエンド)
# =============================================================================

# Vercel CLI / GitHub Actions でのデプロイに使用
# 取得方法: https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token

# Vercel プロジェクト設定
# 取得方法: vercel env pull または Vercel ダッシュボード > Project Settings
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Vercel デプロイ先 URL (preview / production)
# VERCEL_URL は Vercel が自動設定するため、通常は設定不要
# VERCEL_URL=your-deployment.vercel.app

# =============================================================================
# LINE / Lステップ連携
# =============================================================================

LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LSTEP_API_KEY=your-lstep-api-key

# =============================================================================
# AWS (バックエンドデプロイ)
# =============================================================================

AWS_REGION=us-east-1
ECR_REPOSITORY=animalekarte-api
ECS_CLUSTER=animalekarte-cluster
ECS_SERVICE=animalekarte-service
