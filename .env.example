# =============================================================================
# AnimalEkarte — ローカル Docker 用環境変数テンプレート
# =============================================================================
#
# 別マシン / 別環境で開発するとき:
#   cp .env.example .env.local
#   docker compose up -d
#   # 必要なら make reset
#
# - compose は env_file: .env.local を読む（.env は使わない）
# - .env.local は Git 管理外。このファイル（.env.example）だけを共有する
# - 下の DB_PASSWORD / JWT_SECRET は「ローカル Docker 専用の共有ダミー」。
#   STG/本番や共有シークレットには絶対に使わないこと
# - LINE / Vercel / AWS の実トークンは書かない（必要なら各人の .env.local に追加）
#
# =============================================================================

# Database (local Docker — service name is "db")
DB_HOST=db
DB_PORT=5432
DB_USER=ekarte_user
DB_PASSWORD=ekarte_local_dev_password
DB_NAME=ekarte_db
DB_SSL_MODE=disable

# Application
APP_ENV=development
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug

# Auth (local-only dummy; must be >= 32 chars)
JWT_SECRET=ekarte-local-dev-jwt-secret-not-for-production-use-32c

# CORS / Cookie (local frontend on :3003)
CORS_ALLOWED_ORIGIN=http://localhost:3003
COOKIE_DOMAIN=localhost
COOKIE_CROSS_DOMAIN=false

# Migration
DB_RESET=false

# Dev Admin Bypass (ローカル専用。空 = 無効)
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Optional — フロント / 外部連携（使うときだけ .env.local に追記）
# -----------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8080
# VITE_LIFF_ID=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LSTEP_API_KEY=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# LIFF local mock (never enable in release/production)
# Frontend compose sets VITE_LIFF_MOCK=true; backend compose sets LIFF_MOCK=true.
LIFF_MOCK=true
# VITE_LIFF_MOCK is set in docker-compose frontend service (not via env_file).
