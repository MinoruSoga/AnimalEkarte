# ──────────────────────────────────────────────
# Animal Ekarte - 環境変数（.env にコピーして使用）
# ──────────────────────────────────────────────

# Database
DB_USER=ekarte_user
DB_PASSWORD=ekarte_password
DB_NAME=ekarte_db

# DB Reset（true: DROP & 再作成、false: 通常マイグレーション）
# 001_init.sql を直接編集した場合は true にして make reset を実行
DB_RESET=false
