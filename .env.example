# ──────────────────────────────────────────────
# Animal Ekarte - 環境変数サンプル
# ──────────────────────────────────────────────

# --- Backend ---
PORT=8080
GIN_MODE=debug # debug | release

# Database
DB_HOST=db
DB_PORT=5432
DB_USER=ekarte_user
DB_PASSWORD=ekarte_password
DB_NAME=ekarte_db
DB_SSL_MODE=disable

# DB Reset（true: 起動時に DROP & 再作成を行う。開発初期のみ使用）
DB_RESET=false

# Security
# 本番環境では必ずランダムな文字列に変更してください
JWT_SECRET=dev-secret-change-me

# Dev Bypass (開発用バックドア、空文字で無効)
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=password

# --- Frontend ---
# Vite 開発サーバーポート
VITE_PORT=3000
# API エンドポイント (Docker ネットワーク内またはホスト)
VITE_API_URL=http://localhost:8080/api/v1
