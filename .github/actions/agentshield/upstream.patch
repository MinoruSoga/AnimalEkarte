index 0000000..825f021
--- /dev/null
+++ b/src/rules/prohibited-command-reference.ts
@@ -0,0 +1,35 @@
+/** Classify a quoted prohibition, never infer runtime enforcement from prose. */
+export function isProhibitedCommandReference(content: string, index: number, length: number): boolean {
+  if (index < 0 || length <= 0 || index + length > content.length) return false;
+  const start = content.lastIndexOf("\n", index - 1) + 1;
+  const next = content.indexOf("\n", index);
+  const line = content.slice(start, next === -1 ? content.length : next).replace(/\r$/, "");
+  const relativeIndex = index - start;
+  const isQuoted = [...line.matchAll(/`[^`\r\n]+`/g)].some((match) =>
+    relativeIndex > (match.index ?? 0) && relativeIndex + length < (match.index ?? 0) + match[0].length,
+  );
+  if (!isQuoted) return false;
+
+  let fence: { character: string; length: number } | null = null;
+  let prohibitionSection = false;
+  for (const raw of content.slice(0, start).split("\n")) {
+    const previous = raw.replace(/\r$/, "");
+    const marker = previous.match(/^ {0,3}(`{3,}|~{3,})(.*)$/);
+    if (marker) {
+      if (!fence) fence = { character: marker[1][0], length: marker[1].length };
+      else if (marker[1][0] === fence.character && marker[1].length >= fence.length && !marker[2].trim()) fence = null;
+      continue;
+    }
+    if (fence) continue;
+    const heading = previous.match(/^ {0,3}#{1,6}\s+(.+)$/);
+    if (heading) {
+      // Narrow, explicit section grammar. Ambiguous headings retain high severity.
+      prohibitionSection = !!heading[1].match(/^[^()`]*(?:\((?:hard-blocked|forbidden|prohibited)\s*(?:—|:|-)\s*(?:agents\s+)?must never (?:run|execute)\))$/i);
+    }
+  }
+  if (fence) return false;
+  // Only complete negative clauses or code-only list entries qualify. No
+  // exceptions, instructions after a quote, or executable fenced blocks.
+  if (line.match(/^ {0,3}(?:[-*+]\s+)?(?:Never|Do not|Must not) (?:run|execute|use) `[^`]+`(?:\s*\/\s*`[^`]+`)*\.?\s*$/i)) return true;
+  return prohibitionSection && !!line.match(/^ {0,3}[-*+]\s+`[^`]+`(?:\s*\/\s*`[^`]+`)*\s*$/);
+}
