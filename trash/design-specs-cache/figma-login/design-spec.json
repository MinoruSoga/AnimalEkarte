{
  "pass": 7,
  "title": "Final Integrated Design Specification",
  "description": "Consolidated spec for the Animal Ekarte login page — combines all 7 passes",
  "meta": {
    "page": "Login",
    "system": "Animal Ekarte - 動物病院電子カルテ",
    "language": "Japanese",
    "screenshot-source": "/tmp/login_desktop.png",
    "extracted": "2026-03-12"
  },

  "layout": {
    "page-bg": "#F1F0EE",
    "layout-type": "centered-column",
    "container-max-width": "400px",
    "container-padding": "48px 16px 64px",
    "sections-order": ["LogoBlock", "LoginForm", "DemoAccountSection"]
  },

  "colors": {
    "brand-teal": "#038B94",
    "brand-teal-hover": "#027880",
    "page-bg": "#F1F0EE",
    "surface-white": "#FFFFFF",
    "text-heading": "#1F2937",
    "text-dark": "#374151",
    "text-muted": "#6B7280",
    "text-placeholder": "#9CA3AF",
    "border-default": "#D1D5DB",
    "border-light": "#E5E7EB",
    "bg-subtle": "#F3F4F6",
    "avatar-bg": "#E5E7EB",
    "error-red": "#EF4444"
  },

  "typography": {
    "font-family": "system-ui, -apple-system, sans-serif",
    "styles": {
      "clinic-name":      { "size": "28px", "weight": 700, "color": "#1F2937", "align": "center" },
      "subtitle":         { "size": "14px", "weight": 400, "color": "#6B7280", "align": "center" },
      "input-label":      { "size": "13px", "weight": 500, "color": "#374151", "align": "left" },
      "input-text":       { "size": "15px", "weight": 400, "color": "#1F2937" },
      "input-placeholder":{ "size": "15px", "weight": 400, "color": "#9CA3AF" },
      "button-label":     { "size": "15px", "weight": 600, "color": "#FFFFFF", "align": "center" },
      "demo-heading":     { "size": "12px", "weight": 400, "color": "#6B7280", "align": "center" },
      "demo-pw-hint":     { "size": "12px", "weight": 400, "color": "#6B7280", "align": "center" },
      "demo-name":        { "size": "14px", "weight": 500, "color": "#374151" },
      "demo-role-badge":  { "size": "11px", "weight": 400, "color": "#6B7280" },
      "demo-email":       { "size": "12px", "weight": 400, "color": "#9CA3AF" },
      "avatar-char":      { "size": "14px", "weight": 500, "color": "#6B7280" }
    }
  },

  "components": {
    "LogoBlock": {
      "layout": "flex-col items-center",
      "margin-bottom": "32px",
      "LogoIcon": {
        "size": "48px × 48px",
        "border-radius": "12px",
        "bg": "#038B94",
        "icon": "stethoscope (white, 24px)",
        "margin-bottom": "16px"
      },
      "ClinicName": {
        "tag": "h1",
        "text": "ノア動物病院",
        "style": "clinic-name"
      },
      "Subtitle": {
        "tag": "p",
        "text": "管理システムにログイン",
        "style": "subtitle",
        "margin-top": "4px"
      }
    },

    "LoginForm": {
      "tag": "form",
      "layout": "flex-col",
      "gap": "16px",
      "EmailFieldGroup": {
        "layout": "flex-col gap-[6px]",
        "Label": { "text": "メールアドレス", "style": "input-label" },
        "Input": {
          "type": "email",
          "placeholder": "例: admin@example.com",
          "height": "44px",
          "padding": "0 12px",
          "border-radius": "6px",
          "border": "1px solid #D1D5DB",
          "bg": "#FFFFFF",
          "focus-ring": "2px solid #038B94"
        }
      },
      "PasswordFieldGroup": {
        "layout": "flex-col gap-[6px]",
        "Label": { "text": "パスワード", "style": "input-label" },
        "InputWrapper": {
          "position": "relative",
          "Input": {
            "type": "password",
            "placeholder": "パスワードを入力",
            "height": "44px",
            "padding": "0 40px 0 12px",
            "border-radius": "6px",
            "border": "1px solid #D1D5DB",
            "bg": "#FFFFFF",
            "focus-ring": "2px solid #038B94"
          },
          "ToggleButton": {
            "position": "absolute right-[12px] top-1/2 -translate-y-1/2",
            "icon": "Eye / EyeOff (lucide)",
            "icon-size": "16px",
            "color-default": "#9CA3AF",
            "color-hover": "#6B7280",
            "aria-label": "パスワードを表示/非表示"
          }
        }
      },
      "SubmitButton": {
        "tag": "button[type=submit]",
        "text": "ログイン",
        "width": "100%",
        "height": "44px",
        "border-radius": "6px",
        "bg": "#038B94",
        "bg-hover": "#027880",
        "text-style": "button-label"
      }
    },

    "DemoAccountSection": {
      "margin-top": "24px",
      "SectionDivider": {
        "layout": "flex items-center gap-[12px]",
        "lines": "1px solid #E5E7EB",
        "label": {
          "text": "デモアカウント",
          "style": "demo-heading"
        }
      },
      "PasswordHint": {
        "text": "パスワード: password",
        "style": "demo-pw-hint",
        "margin-bottom": "12px"
      },
      "DemoAccountList": {
        "layout": "flex-col gap-[4px]",
        "DemoAccountRow": {
          "layout": "flex items-center gap-[12px]",
          "padding": "8px",
          "border-radius": "8px",
          "bg-default": "transparent",
          "bg-hover": "rgba(255,255,255,0.6)",
          "cursor": "pointer",
          "click-behavior": "auto-fill email input",
          "Avatar": {
            "size": "32px × 32px",
            "border-radius": "50%",
            "bg": "#E5E7EB",
            "char-style": "avatar-char"
          },
          "AccountInfo": {
            "layout": "flex-col",
            "NameRow": {
              "layout": "flex items-center gap-[6px]",
              "Name": { "style": "demo-name" },
              "RoleBadge": {
                "style": "demo-role-badge",
                "bg": "#F3F4F6",
                "border": "1px solid #E5E7EB",
                "border-radius": "4px",
                "padding": "2px 6px"
              }
            },
            "Email": { "style": "demo-email" }
          },
          "demo-accounts-data": [
            { "char": "田", "name": "田中 太郎", "role": "医院管理者", "email": "admin@example.com" },
            { "char": "山", "name": "山田 花子", "role": "医師",      "email": "vet@example.com" },
            { "char": "佐", "name": "佐藤 美咲", "role": "看護師",    "email": "nurse@example.com" },
            { "char": "鈴", "name": "鈴木 一郎", "role": "受付",      "email": "reception@example.com" },
            { "char": "高", "name": "高橋 さくら","role": "トリマー", "email": "trimmer@example.com" },
            { "char": "本", "name": "本部 管理者", "role": "運営管理者","email": "system@example.com" }
          ]
        }
      }
    }
  },

  "states": {
    "input-focus": "ring-2 ring-[#038B94] border-transparent",
    "input-error": "ring-2 ring-[#EF4444] border-transparent",
    "button-hover": "bg-[#027880] transition-colors",
    "button-loading": "opacity-80 cursor-not-allowed (spinner + ログイン中...)",
    "demo-row-hover": "bg-white/60 rounded-lg transition-colors",
    "password-toggle": "EyeIcon → EyeOffIcon when password visible"
  },

  "accessibility": {
    "landmarks": "main, form",
    "heading-level": "h1 for clinic name",
    "label-association": "htmlFor linked to input id",
    "aria-live": "polite region for auth error messages",
    "keyboard": "Tab through all interactive elements in visual order",
    "focus-visible": "2px solid #038B94 ring on all interactive elements",
    "contrast-notes": "Placeholder #9CA3AF may need to be darkened to #6B7280 for strict AA compliance"
  },

  "tailwind-class-map": {
    "page-wrapper": "min-h-screen bg-[#F1F0EE] flex flex-col items-center",
    "container": "w-full max-w-[400px] px-4 pt-12 pb-16",
    "logo-block": "flex flex-col items-center mb-8",
    "logo-icon": "w-12 h-12 rounded-xl bg-[#038B94] flex items-center justify-center mb-4",
    "clinic-name": "text-[28px] font-bold text-[#1F2937] text-center",
    "subtitle": "text-sm text-[#6B7280] text-center mt-1",
    "form": "flex flex-col gap-4 w-full",
    "field-group": "flex flex-col gap-1.5",
    "label": "text-[13px] font-medium text-[#374151]",
    "input": "w-full h-11 px-3 rounded-md border border-[#D1D5DB] bg-white text-[15px] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:ring-[#038B94] focus:border-transparent",
    "password-wrapper": "relative",
    "toggle-btn": "absolute right-3 top-1/2 -translate-y-1/2 text-[#9CA3AF] hover:text-[#6B7280]",
    "submit-btn": "w-full h-11 rounded-md bg-[#038B94] text-white text-[15px] font-semibold hover:bg-[#027880] transition-colors",
    "demo-section": "mt-6 w-full",
    "divider": "flex items-center gap-3 mb-2",
    "divider-line": "flex-1 h-px bg-[#E5E7EB]",
    "divider-label": "text-xs text-[#6B7280] whitespace-nowrap",
    "pw-hint": "text-xs text-[#6B7280] text-center mb-3",
    "account-list": "flex flex-col gap-1",
    "account-row": "flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-white/60 cursor-pointer transition-colors",
    "avatar": "w-8 h-8 rounded-full bg-[#E5E7EB] flex items-center justify-center flex-shrink-0",
    "avatar-char": "text-sm font-medium text-[#6B7280]",
    "account-info": "flex flex-col",
    "name-row": "flex items-center gap-1.5",
    "account-name": "text-sm font-medium text-[#374151]",
    "role-badge": "text-[11px] text-[#6B7280] bg-[#F3F4F6] border border-[#E5E7EB] rounded px-1.5 py-0.5",
    "account-email": "text-xs text-[#9CA3AF]"
  }
}
