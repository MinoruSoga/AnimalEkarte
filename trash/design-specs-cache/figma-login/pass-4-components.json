{
  "pass": 4,
  "title": "Component Tree",
  "description": "Full component hierarchy for the login page",
  "root": {
    "name": "LoginPage",
    "type": "page",
    "className": "min-h-screen bg-[#F1F0EE] flex flex-col items-center",
    "children": [
      {
        "name": "LoginContainer",
        "type": "wrapper-div",
        "className": "w-full max-w-[400px] px-4 pt-12 pb-16",
        "children": [
          {
            "name": "LogoBlock",
            "type": "section",
            "className": "flex flex-col items-center mb-8",
            "children": [
              {
                "name": "LogoIcon",
                "type": "div (icon container)",
                "className": "w-12 h-12 rounded-xl bg-[#038B94] flex items-center justify-center mb-4",
                "children": [
                  {
                    "name": "StethoscopeIcon",
                    "type": "svg / lucide icon",
                    "className": "text-white w-6 h-6",
                    "notes": "Stethoscope icon with a small paw overlay, or a custom combined icon"
                  }
                ]
              },
              {
                "name": "ClinicName",
                "type": "h1",
                "className": "text-[28px] font-bold text-[#1F2937] text-center",
                "text": "ノア動物病院"
              },
              {
                "name": "Subtitle",
                "type": "p",
                "className": "text-[14px] text-[#6B7280] text-center mt-1",
                "text": "管理システムにログイン"
              }
            ]
          },
          {
            "name": "LoginForm",
            "type": "form",
            "className": "flex flex-col gap-4 w-full",
            "children": [
              {
                "name": "EmailFieldGroup",
                "type": "div",
                "className": "flex flex-col gap-1.5",
                "children": [
                  {
                    "name": "EmailLabel",
                    "type": "label",
                    "className": "text-[13px] font-medium text-[#374151]",
                    "text": "メールアドレス"
                  },
                  {
                    "name": "EmailInput",
                    "type": "input[type=email]",
                    "className": "w-full h-11 px-3 rounded-md border border-[#D1D5DB] bg-white text-[15px] text-[#1F2937] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:ring-[#038B94] focus:border-transparent",
                    "attributes": {
                      "placeholder": "例: admin@example.com",
                      "autocomplete": "email"
                    }
                  }
                ]
              },
              {
                "name": "PasswordFieldGroup",
                "type": "div",
                "className": "flex flex-col gap-1.5",
                "children": [
                  {
                    "name": "PasswordLabel",
                    "type": "label",
                    "className": "text-[13px] font-medium text-[#374151]",
                    "text": "パスワード"
                  },
                  {
                    "name": "PasswordInputWrapper",
                    "type": "div (relative positioned)",
                    "className": "relative",
                    "children": [
                      {
                        "name": "PasswordInput",
                        "type": "input[type=password]",
                        "className": "w-full h-11 px-3 pr-10 rounded-md border border-[#D1D5DB] bg-white text-[15px] text-[#1F2937] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:ring-[#038B94] focus:border-transparent",
                        "attributes": {
                          "placeholder": "パスワードを入力",
                          "autocomplete": "current-password"
                        }
                      },
                      {
                        "name": "PasswordToggleButton",
                        "type": "button[type=button]",
                        "className": "absolute right-3 top-1/2 -translate-y-1/2 text-[#9CA3AF] hover:text-[#6B7280]",
                        "children": [
                          {
                            "name": "EyeIcon",
                            "type": "svg / lucide Eye",
                            "className": "w-4 h-4"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "name": "LoginButton",
                "type": "button[type=submit]",
                "className": "w-full h-11 rounded-md bg-[#038B94] text-white text-[15px] font-semibold hover:bg-[#027880] transition-colors",
                "text": "ログイン"
              }
            ]
          },
          {
            "name": "DemoAccountSection",
            "type": "section",
            "className": "mt-6 w-full",
            "children": [
              {
                "name": "SectionDivider",
                "type": "div",
                "className": "flex items-center gap-3 mb-2",
                "children": [
                  {
                    "name": "DividerLineLeft",
                    "type": "hr / div",
                    "className": "flex-1 h-px bg-[#E5E7EB]"
                  },
                  {
                    "name": "DividerLabel",
                    "type": "span",
                    "className": "text-[12px] text-[#6B7280] whitespace-nowrap",
                    "text": "デモアカウント"
                  },
                  {
                    "name": "DividerLineRight",
                    "type": "hr / div",
                    "className": "flex-1 h-px bg-[#E5E7EB]"
                  }
                ]
              },
              {
                "name": "PasswordHint",
                "type": "p",
                "className": "text-[12px] text-[#6B7280] text-center mb-3",
                "text": "パスワード: password"
              },
              {
                "name": "DemoAccountList",
                "type": "ul / div",
                "className": "flex flex-col gap-1",
                "children": [
                  {
                    "name": "DemoAccountRow",
                    "type": "button / li",
                    "className": "flex items-center gap-3 px-2 py-2 rounded-lg hover:bg-white/60 cursor-pointer transition-colors",
                    "notes": "Repeated for each demo account. Clicking auto-fills email.",
                    "children": [
                      {
                        "name": "Avatar",
                        "type": "div",
                        "className": "w-8 h-8 rounded-full bg-[#E5E7EB] flex items-center justify-center flex-shrink-0",
                        "children": [
                          {
                            "name": "AvatarChar",
                            "type": "span",
                            "className": "text-[14px] font-medium text-[#6B7280]"
                          }
                        ]
                      },
                      {
                        "name": "AccountInfo",
                        "type": "div",
                        "className": "flex flex-col",
                        "children": [
                          {
                            "name": "NameRow",
                            "type": "div",
                            "className": "flex items-center gap-1.5",
                            "children": [
                              {
                                "name": "AccountName",
                                "type": "span",
                                "className": "text-[14px] font-medium text-[#374151]"
                              },
                              {
                                "name": "RoleBadge",
                                "type": "span",
                                "className": "text-[11px] text-[#6B7280] bg-[#F3F4F6] border border-[#E5E7EB] rounded px-1.5 py-0.5"
                              }
                            ]
                          },
                          {
                            "name": "AccountEmail",
                            "type": "span",
                            "className": "text-[12px] text-[#9CA3AF]"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
