{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMR-221 proposed accepted-exclusions payload (not deployed)",
  "description": "Shape only. Semantic validation, independent trust and exact-target authorization are mandatory before formal import.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "sourceCompleteness", "scopes", "tax"],
  "properties": {
    "schemaVersion": {"const": "animalekarte-accepted-exclusions-v1-draft"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["clinicCode", "clinicOrdinal", "runId", "revisionId", "stageBuildId", "sourceBackupSha256", "sourceBackupSizeBytes", "backupSetPosition", "csvSetSha256", "mappingSha256"],
      "properties": {
        "clinicCode": {"$ref": "#/$defs/id"},
        "clinicOrdinal": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "runId": {"$ref": "#/$defs/id"},
        "revisionId": {"$ref": "#/$defs/id"},
        "stageBuildId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "sourceBackupSha256": {"$ref": "#/$defs/sha256"},
        "sourceBackupSizeBytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "backupSetPosition": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "csvSetSha256": {"$ref": "#/$defs/sha256"},
        "mappingSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceCompleteness": {"const": "PARTIAL"},
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scopeId", "reason", "population", "unit", "populationCount", "retainedCount", "excludedCount", "keySet", "measurement", "decision"],
        "properties": {
          "scopeId": {"$ref": "#/$defs/id"},
          "reason": {"enum": ["SOURCE_UNREADABLE", "CONFLICTING_PRIMARY_KEY", "PAYMENT_GRAPH_QUARANTINE"]},
          "population": {"$ref": "#/$defs/id"},
          "unit": {"enum": ["source_distinct_key", "billing_distinct_key"]},
          "populationCount": {"$ref": "#/$defs/count"},
          "retainedCount": {"$ref": "#/$defs/count"},
          "excludedCount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "keySet": {"$ref": "#/$defs/nullableEvidence"},
          "measurement": {"$ref": "#/$defs/evidence"},
          "decision": {"$ref": "#/$defs/nullableEvidence"}
        }
      }
    },
    "tax": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "decision", "semanticTests"],
      "properties": {
        "status": {"enum": ["UNRESOLVED", "VERIFIED"]},
        "decision": {"$ref": "#/$defs/nullableEvidence"},
        "semanticTests": {"$ref": "#/$defs/nullableEvidence"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "VERIFIED"}}},
        "then": {"properties": {
          "decision": {"$ref": "#/$defs/evidence"},
          "semanticTests": {"$ref": "#/$defs/evidence"}
        }}
      }]
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullableEvidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidence"}]}
  }
}
