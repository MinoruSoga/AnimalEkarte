{
  // Agent tool approval: allowlist only (no unrestricted auto-run).
  // https://cursor.com/docs/reference/permissions
  "approvalMode": "allowlist",
  "mcpAllowlist": [
    "chrome-devtools"
  ],
  "terminalAllowlist": [
    "git",
    "docker",
    "docker compose",
    "make",
    "gh",
    "bash",
    "sh",
    "node",
    "npm",
    "pnpm",
    "yarn",
    "python",
    "python3",
    "go",
    "cargo",
    "curl",
    "wget",
    "cat",
    "ls",
    "mkdir",
    "chmod",
    "test",
    "rg",
    "grep",
    "find",
    "wc",
    "head",
    "tail",
    "sed",
    "awk",
    "echo",
    "printf",
    "tee",
    "xargs"
  ],
  "autoRun": {
    "allow_instructions": [
      "Allow standard local development shell commands on the terminalAllowlist without approval.",
      "Allow git commit, git add, git push, and git status when the user requested version control work."
    ],
    "block_instructions": [
      "Block git commit when .env.staging or other obvious secret files are staged.",
      "Block unrestricted network installs (remote pipe-to-shell or unpinned installers)."
    ]
  }
}
