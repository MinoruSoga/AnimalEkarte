{
  "scripts": {
    "deploy:frontend": "cd frontend && vercel deploy",
    "deploy:frontend:prod": "cd frontend && vercel deploy --prod",
    "codex-security:export": "bash scripts/export-codex-security-latest.sh",
    "cf:whoami": "wrangler whoami",
    "cf:deploy": "cd backend && wrangler deploy",
    "cf:migrate": "./infra/scripts/cf-run-migrate.sh",
    "cf:scheduler": "./infra/scripts/cf-scheduler-ops.sh",
    "cf:smoke": "./infra/scripts/cf-crud-smoke.sh",
    "cf:load-smoke": "k6 run load-tests/k6-cf-stg-sustained.js",
    "test:worker": "vitest run --config backend/worker/vitest.config.mts backend/worker",
    "typecheck:worker": "tsc --project backend/worker/tsconfig.test.json"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@openai/codex": "^0.120.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@openai/codex-security": "^0.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "packageManager": "pnpm@10.15.0"
