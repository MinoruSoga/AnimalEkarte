{
  "general": {
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d"
    },
    "vimMode": false,
    "useWriteTodos": true,
    "checkpointing": {
      "enabled": true
    }
  },
  "ui": {
    "theme": "GitHub",
    "showLineNumbers": true,
    "showModelInfoInChat": true
  },
  "context": {
    "fileName": ["GEMINI.md"],
    "fileFiltering": {
      "respectGitIgnore": true
    }
  },
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@1.0.4",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "env": {}
    },
    "context7-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@2.1.4"
      ],
      "env": {}
    },
    "figma": {
      "type": "sse",
      "url": "http://127.0.0.1:3845/sse"
    }
  }
}
