
FROM node:24-alpine

# Keep dependency lifecycle scripts restricted by
# frontend/package.json pnpm.onlyBuiltDependencies.
RUN apk add --no-cache tzdata && npm install -g pnpm@10.15.0

ENV TZ=Asia/Tokyo

WORKDIR /app

COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["pnpm", "dev"]
