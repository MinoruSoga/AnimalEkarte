
FROM node:24-alpine

# pnpm@9 is a single-package app. Do not add frontend/pnpm-workspace.yaml:
# pnpm 10+ approve-builds writes allowBuilds without `packages`, and
# `pnpm run` then exits 1 ("packages field missing or empty").
RUN apk add --no-cache tzdata && npm install -g pnpm@9

ENV TZ=Asia/Tokyo

WORKDIR /app

COPY entrypoint.sh ./
RUN chmod +x entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["pnpm", "dev"]
