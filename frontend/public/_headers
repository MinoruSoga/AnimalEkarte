# EMR-255: Vercel(frontend/vercel.json) の headers セクションを Workers Static Assets へ移植。
# Vite が public/ を dist/ 直下へコピーするため、本ファイルは dist/_headers として
# Cloudflare の asset server が各レスポンスへ適用する。
# connect-src は frontend/vercel.json から api.noah-karte.com を追加したもの
# （PROD でも同一 CSP を維持する。同一オリジン化で API 呼出は 'self' に集約されるが、
# 移行期・workers.dev プレビューからの絶対 URL 参照を壊さないため両 host を残す）。

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://api.stg.noah-karte.com https://api.noah-karte.com https://zipcloud.ibsnet.co.jp https://*.line.me https://*.line-scdn.net; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
