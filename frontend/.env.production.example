# Vercel production-mode env (pnpm build). GitHub Actions の VERCEL_ENV があるとき
# frontend/vite.config.ts が VITE_API_URL を define で上書きする。
# preview → https://api.stg.noah-karte.com/api
# production → https://api.noah-karte.com/api
# この値は VERCEL_ENV 未設定のフォールバック（AWS ALB は CSP で遮断される）。
VITE_API_URL=https://api.stg.noah-karte.com/api

# --- Local DEV: gitignored frontend/.env.local only (never commit) ---
# STG preview: GitHub Actions injects this at prebuilt time (not Vercel Production).
# Must match staff-attach shared secret. Helper: python3 scripts/sync-vite-demo-login-password.py
# VITE_DEMO_LOGIN_PASSWORD=
