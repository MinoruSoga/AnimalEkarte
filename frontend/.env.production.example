# Vercel Production Environment Variables
# Vercel Dashboard > Settings > Environment Variables で以下を設定

# Backend API URL (ALB endpoint)
VITE_API_URL=http://your-alb-dns-name.us-east-1.elb.amazonaws.com/api

# --- Local DEV: gitignored frontend/.env.local only (never commit) ---
# STG preview: GitHub Actions injects this at prebuilt time (not Vercel Production).
# Must match staff-attach shared secret. Helper: python3 scripts/sync-vite-demo-login-password.py
# VITE_DEMO_LOGIN_PASSWORD=
