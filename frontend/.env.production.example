# Vercel Production Environment Variables
# Vercel Dashboard > Settings > Environment Variables で以下を設定

# Backend API URL (ALB endpoint)
VITE_API_URL=http://your-alb-dns-name.us-east-1.elb.amazonaws.com/api

# --- Local DEV only (do NOT set on Vercel production/preview) ---
# One-click demo login password must match staff-attach shared secret.
# Put the real value only in gitignored frontend/.env.local (never commit).
# Helper: python3 scripts/sync-vite-demo-login-password.py
# VITE_DEMO_LOGIN_PASSWORD=
